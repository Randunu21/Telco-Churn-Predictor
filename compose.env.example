# Copy to compose.env (git-ignored) and replace BOTH <change-me> values with
# the SAME password, e.g. from: openssl rand -hex 24  (letters/digits only).
POSTGRES_USER=mlflow
POSTGRES_DB=mlflow
POSTGRES_PASSWORD=<change-me>

# MLflow backend URI: the password MUST be identical to POSTGRES_PASSWORD above.
# Keep the explicit +psycopg2 driver (see requirements/mlflow-server.txt).
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://mlflow:<change-me>@postgres:5432/mlflow
